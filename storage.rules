rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }
    function validImage() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /productos/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && admin() && validImage();
      allow delete: if signedIn() && admin();
    }
    match /comprobantes/{uid}/{fileName} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && validImage();
      allow update, delete: if admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
